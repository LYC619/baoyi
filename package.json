{
  "name": "baoyi",
  "productName": "抱一",
  "version": "0.6.0",
  "description": "抱一 — 本地资源掌控工具。知止而后得。",
  "author": "BaoYi",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "selfcheck": "node --experimental-strip-types --no-warnings scripts/agent-selfcheck.ts",
    "check-modules": "node --experimental-strip-types --no-warnings scripts/check-module-memory.ts",
    "try-game": "node --experimental-strip-types --no-warnings scripts/try-game-identify.ts",
    "verify-migration": "node --experimental-strip-types --no-warnings scripts/verify-migration.ts",
    "verify-reset-seed": "node --experimental-strip-types --no-warnings scripts/verify-reset-seed.ts",
    "verify-reset": "node --experimental-strip-types --no-warnings scripts/verify-reset-cdp.ts",
    "rollback-v5": "node --experimental-strip-types --no-warnings scripts/rollback-v5.ts",
    "rollback-v6": "node --experimental-strip-types --no-warnings scripts/rollback-v6.ts",
    "rollback-v7": "node --experimental-strip-types --no-warnings scripts/rollback-v7.ts",
    "verify-rollback-v7": "node --experimental-strip-types --no-warnings scripts/verify-rollback-v7.ts",
    "inspect": "set ELECTRON_RUN_AS_NODE=1&& electron scripts/inspect-db.cjs",
    "preview": "vite preview",
    "rebuild": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "build-save-manifest": "node --experimental-strip-types --no-warnings scripts/build-save-manifest.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "resedit": "^2.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22.13.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "37.10.3",
    "electron-builder": "^26.0.12",
    "fast-xml-parser": "^5.11.1",
    "js-yaml": "4.3.1",
    "lucide-vue-next": "^0.475.0",
    "mediainfo.js": "^0.3.7",
    "pinia": "^2.3.1",
    "sass": "^1.85.0",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vite-plugin-electron": "^0.29.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.2"
  }
}
