{
  "name": "baoyi",
  "productName": "抱一",
  "version": "0.8.0",
  "description": "抱一 — 本地资源掌控工具。知止而后得。",
  "author": "BaoYi",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "selfcheck": "node --experimental-strip-types --no-warnings scripts/agent-selfcheck.ts",
    "check-modules": "node --experimental-strip-types --no-warnings scripts/check-module-memory.ts",
    "try-game": "node --experimental-strip-types --no-warnings scripts/try-game-identify.ts",
    "verify-migration": "node --experimental-strip-types --no-warnings scripts/verify-migration.ts",
    "verify-reset-seed": "node --experimental-strip-types --no-warnings scripts/verify-reset-seed.ts",
    "verify-reset": "node --experimental-strip-types --no-warnings scripts/verify-reset-cdp.ts",
    "verify-video-seed": "node --experimental-strip-types --no-warnings scripts/verify-video-seed.ts",
    "verify-video": "node --experimental-strip-types --no-warnings scripts/verify-video-cdp.ts",
    "verify-hentai-e2e": "node --experimental-strip-types --no-warnings scripts/verify-hentai-e2e.ts",
    "verify-task-center": "node --experimental-strip-types --no-warnings scripts/verify-task-center.ts",
    "verify-hanime-verification": "node --experimental-strip-types --no-warnings scripts/verify-hanime-verification.ts",
    "verify-video-download": "node --experimental-strip-types --no-warnings scripts/verify-video-download.ts",
    "verify-video-download-service": "node --experimental-strip-types --no-warnings scripts/verify-video-download-service.ts",
    "verify-video-download-network": "node --experimental-strip-types --no-warnings scripts/verify-video-download-network.ts",
    "verify-video-download-electron": "electron scripts/verify-video-download-electron.cjs",
    "verify-video-library-scan": "node --experimental-strip-types --no-warnings scripts/verify-video-library-scan.ts",
    "verify-video-library-db": "node --experimental-strip-types --no-warnings scripts/verify-video-library-db.ts",
    "verify-video-library-service": "node --experimental-strip-types --no-warnings scripts/verify-video-library-service.ts",
    "verify-video-library-ui": "node --experimental-strip-types --no-warnings scripts/verify-video-library-ui.ts",
    "verify-video-packaged-ui": "node --experimental-strip-types --no-warnings scripts/verify-video-packaged-ui.ts",
    "verify-video-posters": "node --experimental-strip-types --no-warnings scripts/verify-video-posters.ts",
    "verify-game-covers": "node --experimental-strip-types --no-warnings scripts/verify-game-covers.ts",
    "verify-game-covers-electron": "electron scripts/verify-game-covers-electron.cjs",
    "verify-video-download-ui": "node --experimental-strip-types --no-warnings scripts/verify-video-download-ui.ts",
    "verify-video-series-download-ui": "node --experimental-strip-types --no-warnings scripts/verify-video-series-download-ui.ts",
    "verify-video-series-download": "node --experimental-strip-types --no-warnings scripts/verify-video-series-download.ts",
    "verify-identify": "node --experimental-strip-types --no-warnings scripts/verify-identify-cdp.ts",
    "verify-icons": "set ELECTRON_RUN_AS_NODE=1&& electron --experimental-strip-types --no-warnings scripts/verify-icons.ts",
    "probe-icons": "electron scripts/probe-icons.cjs",
    "rollback-v5": "node --experimental-strip-types --no-warnings scripts/rollback-v5.ts",
    "rollback-v6": "node --experimental-strip-types --no-warnings scripts/rollback-v6.ts",
    "rollback-v7": "node --experimental-strip-types --no-warnings scripts/rollback-v7.ts",
    "rollback-v8": "node --experimental-strip-types --no-warnings scripts/rollback-v8.ts",
    "rollback-v9": "node --experimental-strip-types --no-warnings scripts/rollback-v9.ts",
    "verify-rollback-v7": "node --experimental-strip-types --no-warnings scripts/verify-rollback-v7.ts",
    "verify-rollback-v9": "node --experimental-strip-types --no-warnings scripts/verify-rollback-v9.ts",
    "verify-proxy": "electron scripts/verify-proxy.cjs",
    "probe-hanime": "electron scripts/probe-hanime-proxy.cjs",
    "probe-hanime-api": "electron scripts/probe-hanime-api.cjs",
    "verify-packaged": "node --experimental-strip-types --no-warnings scripts/verify-packaged.ts",
    "inspect": "set ELECTRON_RUN_AS_NODE=1&& electron scripts/inspect-db.cjs",
    "preview": "vite preview",
    "rebuild": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "build-save-manifest": "node --experimental-strip-types --no-warnings scripts/build-save-manifest.ts",
    "dist:portable": "npm run build && electron-builder --dir --config.extends=electron-builder.yml --config.extends=./electron-builder.portable.yml --config.directories.output=release/0.8.0-portable"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "resedit": "^2.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22.13.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "37.10.3",
    "electron-builder": "^26.0.12",
    "fast-xml-parser": "^5.11.1",
    "js-yaml": "4.3.1",
    "lucide-vue-next": "^0.475.0",
    "mediainfo.js": "^0.3.7",
    "node-html-parser": "9.0.2",
    "pinia": "^2.3.1",
    "sass": "^1.85.0",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vite-plugin-electron": "^0.29.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.2"
  }
}
