{
  "name": "baoyi",
  "productName": "抱一",
  "version": "0.20.4",
  "description": "抱一 — 本地资源掌控工具。知止而后得。",
  "author": "BaoYi",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build && node scripts/verify-build-boundaries.cjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "selfcheck": "node --experimental-strip-types --no-warnings scripts/agent-selfcheck.ts",
    "eval:archive": "node --experimental-strip-types --no-warnings tests/evals/archive-eval.ts",
    "docs:generate": "node --experimental-strip-types --no-warnings scripts/generate-architecture-docs.ts",
    "docs:check": "node --experimental-strip-types --no-warnings scripts/generate-architecture-docs.ts --check",
    "check-modules": "node --experimental-strip-types --no-warnings scripts/check-module-memory.ts",
    "try-game": "node --experimental-strip-types --no-warnings scripts/try-game-identify.ts",
    "probe-icons": "electron scripts/probe-icons.cjs",
    "probe-hanime": "electron scripts/probe-hanime-proxy.cjs",
    "probe-hanime-api": "electron scripts/probe-hanime-api.cjs",
    "inspect": "set ELECTRON_RUN_AS_NODE=1&& electron scripts/inspect-db.cjs",
    "preview": "vite preview",
    "rebuild": "node node_modules/electron/install.js && node scripts/verify-native-runtime.cjs",
    "postinstall": "node node_modules/electron/install.js && node scripts/verify-native-runtime.cjs",
    "dist": "npm run check:hermes && npm run build && electron-builder --config.electronDist=node_modules/electron/dist",
    "dist:dir": "npm run check:hermes && npm run build && electron-builder --dir --config.electronDist=node_modules/electron/dist",
    "build-save-manifest": "node --experimental-strip-types --no-warnings scripts/build-save-manifest.ts",
    "dist:portable": "npm run check:hermes && npm run build && electron-builder --dir --config electron-builder.portable.yml --config.electronDist=node_modules/electron/dist",
    "dist:green": "npm run check:hermes && npm run build && electron-builder --config electron-builder.green.yml --config.electronDist=node_modules/electron/dist",
    "prepare:hermes": "python -X utf8 scripts/prepare-hermes-runtime.py",
    "check:hermes": "node scripts/check-hermes-runtime.cjs",
    "prepare:comic": "python -X utf8 scripts/prepare-comic-runtime.py",
    "check:comic": "node scripts/check-comic-runtime.cjs",
    "test": "node scripts/run-tests.cjs",
    "test:unit": "node scripts/run-tests.cjs --unit --strict",
    "test:archive": "node scripts/run-tests.cjs archive",
    "test:audio": "node scripts/run-tests.cjs audio",
    "test:comic": "node scripts/run-tests.cjs comic",
    "test:document": "node scripts/run-tests.cjs document",
    "test:game": "node scripts/run-tests.cjs game",
    "test:image": "node scripts/run-tests.cjs image",
    "test:infra": "node scripts/run-tests.cjs infra",
    "test:personal": "node scripts/run-tests.cjs personal",
    "test:project": "node scripts/run-tests.cjs project",
    "test:settings": "node scripts/run-tests.cjs settings",
    "test:software": "node scripts/run-tests.cjs software",
    "test:video": "node scripts/run-tests.cjs video",
    "test:e2e": "node scripts/run-tests.cjs e2e",
    "verify:core": "npm test"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@napi-rs/canvas": "1.0.12",
    "@panzoom/panzoom": "4.6.2",
    "better-sqlite3": "13.0.3",
    "dompurify": "^3.4.17",
    "exifr": "^7.1.3",
    "fast-xml-parser": "^5.11.1",
    "image-size": "2.0.4",
    "lucide-vue-next": "^0.475.0",
    "marked": "^18.1.1",
    "mediainfo.js": "^0.3.7",
    "node-html-parser": "9.0.2",
    "pdfjs-dist": "^6.4.299",
    "pinia": "^2.3.1",
    "resedit": "^2.0.3",
    "vue": "3.5.44",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22.13.5",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "js-yaml": "4.3.2",
    "playwright": "1.64.1",
    "prettier": "3.6.2",
    "sass": "^1.85.0",
    "typescript": "^5.7.3",
    "vite": "8.3.4",
    "vite-plugin-electron": "1.1.2",
    "vue-tsc": "^2.2.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
